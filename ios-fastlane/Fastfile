# Builds the app and ships it straight to TestFlight. Lives outside ios/
# (at the repo root) because ios/ itself is never committed — the CI
# workflow generates it fresh each run with `npx cap add ios`, the same way
# the Android build regenerates android/. This file gets copied into
# ios/fastlane/ right after that, then run from inside ios/.
default_platform(:ios)

platform :ios do
  desc "Build a signed release and upload it to TestFlight"
  lane :beta do
    # On a CI machine this creates a throwaway keychain and makes it the
    # default, so match can import the signing certificate and Xcode can use
    # it without a password prompt. Without it the build sits forever waiting
    # for someone to click "Allow" on a keychain dialog nobody can see.
    setup_ci

    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false
    )

    # Fetches the signing certificate + provisioning profile from the
    # private certs repo (MATCH_GIT_URL), creating them via the App Store
    # Connect API the first time this ever runs. readonly stays false since
    # a fresh Capacitor-generated ios/ project has no profile associated
    # with it yet on every run — match reuses the existing cert either way,
    # it just re-confirms the profile matches.
    # force: true re-issues the provisioning profile every run. Needed once
    # after Push Notifications was switched on for the App ID (the old profile
    # doesn't carry that capability); cheap to leave in.
    match(
      type: "appstore",
      readonly: false,
      force: true
    )

    # fastlane runs from ios/, but Capacitor puts the Xcode project one level
    # down in ios/App/ — so every path below starts with App/.
    #
    # The Info.plist keys: camera + photo library wording for the chat photo
    # picker (iOS crashes the app if the camera is used without a reason
    # string), and the encryption answer so TestFlight doesn't hold every
    # build waiting on a manual export-compliance question (the app only uses
    # standard HTTPS).
    plist = "App/App/Info.plist"
    set_info_plist_value(path: plist, key: "NSCameraUsageDescription", value: "Take photos to share in the team chat.")
    set_info_plist_value(path: plist, key: "NSPhotoLibraryUsageDescription", value: "Choose photos to share in the team chat.")
    set_info_plist_value(path: plist, key: "ITSAppUsesNonExemptEncryption", value: false)

    # The aps-environment entitlements file (App/App/App.entitlements) is written
    # by the workflow before this runs; it is attached to the App target below.

    # Capacitor's project ships with automatic signing; the certificate and
    # profile come from match, so switch it to manual and point it at them.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "App/App.xcodeproj",
      team_id: ENV["APPLE_TEAM_ID"],
      targets: ["App"],
      entitlements_file_path: "App/App.entitlements",
      code_sign_identity: "Apple Distribution",
      profile_name: ENV["sigh_au.com.mintopastoral.farmrecords_appstore_profile-name"]
    )

    build_app(
      workspace: "App/App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      # Capacitor's Info.plist reads its build number from CURRENT_PROJECT_VERSION.
      xcargs: "CURRENT_PROJECT_VERSION=#{ENV['GITHUB_RUN_NUMBER']}",
      export_options: {
        provisioningProfiles: {
          "au.com.mintopastoral.farmrecords" => "match AppStore au.com.mintopastoral.farmrecords"
        }
      }
    )

    upload_to_testflight(skip_waiting_for_build_processing: true)
  end
end
